# ── Environment Variables ──────────────────────────────
# Copy this file to .env.local and fill in the values

# API Base URL
# Default (Live Cloud Backend - No local backend or DB needed to run frontend):
NEXT_PUBLIC_API_URL=https://api-telos-digital-ecommerce-backend.vercel.app/api/v1

# Local Backend (Uncomment if running the backend server locally on port 5001):
# NEXT_PUBLIC_API_URL=http://localhost:5001/api/v1

# App
NEXT_PUBLIC_APP_NAME="Telos Cart"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your_google_client_id"
