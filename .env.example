NEXT_PUBLIC_API_URL=https://api-telos-digital-ecommerce-backend.vercel.app/api/v1

# App
NEXT_PUBLIC_APP_NAME="Telos Cart"
NEXT_PUBLIC_APP_URL=http://localhost:3000
